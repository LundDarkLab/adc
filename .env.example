# ==============================================================================
# Dynamic Collections Plus — environment configuration
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# NOTE for values containing special characters (!, $, #, &, spaces...):
# wrap them in single quotes, e.g. PASSWORD='my&secret!'
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# The MySQL container is initialised with these values on its first start.
# If you change them later you must recreate the database volume
# (docker compose down -v) or change the credentials inside MySQL itself.
# ------------------------------------------------------------------------------
DB_HOST=db                      # Hostname of the database. Keep 'db' (the name of
                                # the MySQL service inside the Docker network)
                                # unless you connect to an external MySQL server.
DB_NAME=dyncoll                 # Name of the application database
DB_USER=dyncoll                 # Application database user
DB_PASSWORD='ChangeMe!'         # Password of the application database user
DB_ROOT_PASSWORD='ChangeMeToo!' # MySQL root password (used only for administration)
DB_PORT=3306                    # HOST port where MySQL is exposed (loopback only).
                                # Only used to reach the database from the host with
                                # external tools (mysql client, DBeaver, ...).
                                # Change it if 3306 is already taken on your server.

# ------------------------------------------------------------------------------
# STORAGE (optional)
# Host directories where uploaded content is stored (3D models, images,
# documents). Defaults to the ./archive and ./img folders of this repository;
# uncomment and change only if you keep the data elsewhere on the server.
# ------------------------------------------------------------------------------
# ARCHIVE_DIR=./archive
# IMG_DIR=./img

# ------------------------------------------------------------------------------
# MAIL (SMTP)
# Used to send account-related emails (registration, password reset).
# Ask your IT department for the SMTP parameters of your institution.
# ------------------------------------------------------------------------------
MAILHOST='smtp.example.com'     # Hostname of the SMTP server
MAILPORT=587                    # SMTP port: 25 plain / 465 SSL / 587 TLS (most common)
MAILUSER='user@example.com'     # SMTP username (usually the full email address)
MAILPASSWORD='yourpassword'     # SMTP password
MAILSETFROM='noreply@example.com'   # "From" address shown in outgoing emails
MAILSETFROMNAME='Dynamic Collections'  # "From" display name (e.g. your institution)
