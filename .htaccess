# Disable directory browsing 
Options -Indexes

<Files .htaccess>
  Order allow,deny
  Deny from all
</Files>

<FilesMatch "\.(ini|sql|log|sh)$">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "frame-src 'self' https://www.youtube.com https://player.vimeo.com; frame-ancestors 'self';"
</IfModule>